/* .back 是 absolute 的，全局 .page 没有定位上下文，得在这一层给出来。 */
.order { position: relative; }

.back {
  position: absolute;
  left: 40rpx;
  width: 64rpx;
  display: flex; align-items: center; justify-content: center;
}
.chev {
  width: 22rpx; height: 22rpx;
  border-left: 1rpx solid var(--ink);
  border-bottom: 1rpx solid var(--ink);
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.ph { color: #B8B1A0; }

/* 「更多／收起」不是一个可选项，是一个开关 —— 得跟旁边那些标签分开。
   去掉边框、改成那点金：有边框的话它看着就是第十一个情景，
   人会去点它然后发现"选不上"。 */
.pill.more {
  box-shadow: none;
  color: var(--brass);
  letter-spacing: 4rpx;
  text-indent: 4rpx;
}

.cover-sm { width: 76rpx; height: 76rpx; border-radius: 10rpx; flex: none; background: var(--paper-sunk); }
.row-txt { flex: 1; min-width: 0; margin-left: 22rpx; }
.row-name {
  font-family: var(--serif);
  font-size: 29rpx;
  color: var(--ink);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.swap {
  flex: none; margin-left: 20rpx;
  font-family: var(--serif); font-size: 25rpx;
  letter-spacing: 2rpx; color: var(--brass);
}
.searching { margin-top: 24rpx; }
