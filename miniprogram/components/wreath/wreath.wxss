:host { display: block; }

/* 环半径 104 + 最大一片叶子的余量，取 260 见方 */
.wreath {
  position: relative;
  width: 260rpx;
  height: 260rpx;
  margin: 0 auto;
}

.leaf {
  position: absolute;
  left: 50%; top: 50%;
  /* 叶形＝只圆两个对角的方块，长轴落在另一条对角线上 */
  border-radius: 100% 0 100% 0;
}

/* 花是个零尺寸的锚点，花瓣绕着它转 —— 挪一朵花只要改一个角度。 */
.bloom {
  position: absolute;
  left: 50%; top: 50%;
  width: 0; height: 0;
}
.petal {
  position: absolute;
  left: 0; top: 0;
  border-radius: 100% 0 100% 0;
}
.core {
  position: absolute;
  left: 0; top: 0;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}
