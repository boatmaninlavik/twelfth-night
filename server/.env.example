# server/.env 的样板。真正的值别提交，也别贴进聊天里 —— 自己打开 server/.env 填。

# 写词（Gemini）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# 出歌（Suno via kie.ai）
SUNO_API_KEY=
SUNO_MODEL=V5

# 存储与数据库（Supabase）。service-role key 能绕过 RLS 读写整个库，
# 只允许存在于服务端，绝不能进小程序或版本库。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=twelfth-night

# 微信小程序。AppSecret 是密钥；AppID 不是。
WX_APPID=
WX_APP_SECRET=
# 订阅消息模板 ID。测试号没有服务类目、拿不到模板，留空则静默跳过通知。
WX_TMPL_SONG_READY=
WX_MP_STATE=developer

# 人声/伴奏比的目标线（dB）。默认 2.46，是从用户认可的那一版量出来的，
# 见 server/worker/balance.py。改交付风格改这一个数，别去动 BAL。
VOCAL_TARGET_DB=2.46
